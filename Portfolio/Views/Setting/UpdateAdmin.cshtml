@model Admin
@{
    ViewData["Title"] = "Profili Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    .create-card {
        border-radius: 16px;
        border: 1px solid #e9ecef;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        width: 100%;
    }

    .create-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px 16px 0 0;
        padding: 24px 28px;
        color: white;
    }

    .create-body {
        padding: 28px;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 6px;
    }

    .form-control {
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        padding: 10px 14px;
        font-size: 0.95rem;
        transition: border 0.2s;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
        }

    .toggle-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f8fafc;
        border-radius: 10px;
        padding: 12px 16px;
        border: 1.5px solid #e2e8f0;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        cursor: pointer;
        accent-color: #667eea;
    }

    .btn-save {
        background: linear-gradient(135deg, #667eea, #764ba2);
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        color: white;
        font-weight: 600;
        transition: opacity 0.2s;
    }

        .btn-save:hover {
            opacity: 0.9;
            color: white;
        }

    .btn-back {
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }
</style>

<div class="create-card">
    <div class="create-header">
        <h5 class="mb-1 fw-bold"><i class="bi bi-plus-circle me-2"></i>Profili Güncelle</h5>
        <p class="mb-0 small opacity-75">Aşağıdaki formu doldurarak profil bilgisini güncelleyin.</p>
    </div>
    <div class="create-body">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label class="form-label">Kullanıcı Adı</label>
                <input type="text" class="form-control" asp-for="UserName" />
                <span class="text-danger small" asp-validation-for="UserName"></span>
            </div>
            <div class="mb-4">
                <label class="form-label">Ad-Soyad</label>
                <input type="text" class="form-control" asp-for="FullName" />
                <span class="text-danger small" asp-validation-for="FullName"></span>
            </div>
            <input type="hidden" asp-for="ImageUrl" />
            <div class="mb-4">
                <label class="form-label">Görsel</label>
                <input type="file" class="form-control border-2" name="ImageFile" accept="image/*" />
                <span class="text-danger" asp-validation-for="ImageUrl"></span>
            </div>
            <div class="mb-4">
                <label class="form-label">Yeni Şifre</label>
                <input type="password" class="form-control" name="newPassword" />
            </div>
            <div class="mb-4">
                <label class="form-label">Şifre Tekrar</label>
                <input type="password" class="form-control" name="confirmPassword" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check-lg me-1"></i>Kaydet
                </button>
                <a href="/Project/Index" class="btn btn-outline-secondary btn-back">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
        </form>
    </div>
</div>



