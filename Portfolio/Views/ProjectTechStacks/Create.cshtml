@model ProjectTechStack
@{
    ViewData["Title"] = "Proje Teknolojileri Oluştur";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h4>Proje Teknoloji Ekleme</h4>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Proje</label>
                    <select asp-for="ProjectId" asp-items="@ViewBag.projects" class="form-select">
                        <option selected disabled>---Proje Seçiniz---</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Teknoloji</label>
                    <select asp-for="TechStackId" asp-items="@ViewBag.techStacks" class="form-select">
                        <option selected disabled>---Teknoloji Seçiniz---</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a href="/ProjectTechStacks/Index" class="btn btn-secondary">Geri Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>