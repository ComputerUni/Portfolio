@model List<About>
@{
    //Default About
}


<section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter relative bg-surface-container-lowest" id="about">
    <div class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-2 gap-stack-lg items-center">
        @foreach (var about in Model)
        {
            <div class="relative w-full aspect-square rounded-xl overflow-hidden glass-card">
                <img alt="Professional portrait" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500" src="@about.ImageUrl" />
            </div>
            <div class="flex flex-col gap-stack-md">
                <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase">Hakkımda</span>
                <h2 class="font-headline-md text-headline-md text-on-background">@about.Title</h2>
                <div class="w-12 h-1 bg-primary rounded-full"></div>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">@about.Description</p>
                @await Component.InvokeAsync("_DefaultSkill")
            </div>
        }
    </div>
</section>
