@model ProjectTechStack

@{
    ViewData["Title"] = "Teknolojiyi Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    .create-card {
        border-radius: 16px;
        border: 1px solid #e9ecef;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        width: 100%;
    }

    .create-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px 16px 0 0;
        padding: 24px 28px;
        color: white;
    }

    .create-body {
        padding: 28px;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 6px;
    }

    .form-control {
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        padding: 10px 14px;
        font-size: 0.95rem;
        transition: border 0.2s;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
        }

    .toggle-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f8fafc;
        border-radius: 10px;
        padding: 12px 16px;
        border: 1.5px solid #e2e8f0;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        cursor: pointer;
        accent-color: #667eea;
    }

    .btn-save {
        background: linear-gradient(135deg, #667eea, #764ba2);
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        color: white;
        font-weight: 600;
        transition: opacity 0.2s;
    }

        .btn-save:hover {
            opacity: 0.9;
            color: white;
        }

    .btn-back {
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }
</style>

<div class="create-card">
    <div class="create-header">
        <h5 class="mb-1 fw-bold"><i class="bi bi-plus-circle me-2"></i>Yeni Hizmet Oluştur</h5>
        <p class="mb-0 small opacity-75">Aşağıdaki formu doldurarak yeni bir hizmet ekleyin.</p>
    </div>
    <div class="create-body">
        <form method="post">
            <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />
            <div class="mb-4">
                <label class="form-label">Proje</label>
                <select class="form-control" asp-items="ViewBag.projects" disabled>
                    <option value="@ViewBag.ProjectId" selected>Seçiniz</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">Teknolojiler</label>
                <select class="form-control" name="techStackIds" multiple style="height:200px;">
                    @{
                        var selectedTechs = ViewBag.SelectedTechs as List<int> ?? new List<int>();
                        var techStacks = ViewBag.techStacks as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
                    }

                    @if (techStacks != null)
                    {
                        @foreach (var item in techStacks)
                        {
                            bool isSelected = int.TryParse(item.Value, out int valId) && selectedTechs.Contains(valId);
                            <option value="@item.Value" selected="@(isSelected ? "selected" : null)">@item.Text</option>
                        }
                    }
                </select>
                <small class="text-muted">Ctrl tuşuna basılı tutarak birden fazla teknoloji seçebilirsiniz.</small>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check-lg me-1"></i>Kaydet
                </button>
                <a href="/ProjectTechStacks/Index" class="btn btn-outline-secondary btn-back">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
        </form>
    </div>
</div>