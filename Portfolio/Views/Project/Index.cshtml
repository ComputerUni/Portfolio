@model List<Project>
@{
    ViewData["Title"] = "Projelerim";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<table class="table table-hover table-bordered">
    <tr>
        <th>Görsel</th>
        <th>Proje Adı</th>
        <th>Proje Açıklaması</th>
        <th>Github Linki</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var project in Model)
    {
        <tr>
            <td>
                <img src="@project.ImageUrl" style="height:50px;width:50px;" />
            </td>
            <td>@project.Name</td>
            <td>@project.Description</td>
            <td><a href="@project.GithubUrl" target="_blank" class="btn btn-outline-secondary">Github Url<a /></td>
            <td>
                <button onclick="deleteProject(@project.Id)" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                <a href="/Project/UpdateProject/@project.Id" class="btn btn-outline-warning"><i class="bi bi-pencil"></i></a>
            </td>

        </tr>
    }
</table>

<a href="/Project/CreateProject" class="btn btn-outline-info">Yeni Proje Oluştur</a>
<script>
    function deleteProject(id)
    {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamayacaksınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, sil!",
            cancelButtonText: "Vazgeç"
        }).then((result) => {
            if (result.isConfirmed)
                window.location.href = "/Project/DeleteProject/"+id;
        });
    }
</script>